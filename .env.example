# Sao chep thanh .env roi sua cho phu hop. KHONG commit file .env.
SECRET_KEY=doi-chuoi-bi-mat-nay
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/data_scam?charset=utf8mb4
ADMIN_PASSWORD=admin123

# Chay server (de demo qua LAN: HOST=0.0.0.0 va SSL_ADHOC=true - trinh duyet chi cho dung camera / micro tren HTTPS / localhost)
HOST=127.0.0.1
PORT=5000
SSL_ADHOC=false
# Danh sach STUN cho WebRTC, cach nhau dau phay. De trong khi chay localhost / LAN.
STUN_URLS=

# Mo hinh AI 3: TF-IDF + Linear SVM (mac dinh tu tim lan train moi nhat trong ai_training/IDF_SVM/outputs/)
# MODEL_SVM_PATH=

# AI 3 - backend: local (mo hinh dang nap trong app) | http | python | mock
# (mo hinh nhan dien THEO KICH BAN sau nay: dung http hoac python, nhan ca cuoc tro chuyen)
AGENT3_BACKEND=local
AGENT3_URL=
AGENT3_TIMEOUT=15
# vd: my_model.infer:analyze  (ham analyze(payload: dict) -> dict)
AGENT3_MODULE=

# Phan tich nen (true). Dat false de chay dong bo khi go loi.
GUARDIAN_ASYNC=true
# Nut dang nhap nhanh tai khoan demo o trang dang nhap va /demo
DEMO_QUICK_LOGIN=true

# Truy vet IP ke lua dao (chi quan tri vien xem o /admin)
# Chay sau proxy (nginx / ngrok): true de lay IP that tu X-Forwarded-For. Chay truc tiep: de false (chong gia mao IP).
TRUST_PROXY=false
# IP cua moi tin nhan + nhat ky dang nhap tu xoa sau N ngay (ho so truy vet khi tu dong chan duoc giu lau dai)
IP_RETENTION_DAYS=30
# Dinh vi offline: duong dan file .mmdb (DB-IP Lite City hoac MaxMind GeoLite2-City), vd data/geoip/dbip-city-lite.mmdb
GEOIP_DB_PATH=
# Dinh vi online qua ip-api.com khi khong co file .mmdb (gui IP ra dich vu ngoai, can Internet). Mac dinh tat.
GEOIP_ONLINE=false
GEOIP_TIMEOUT=3
